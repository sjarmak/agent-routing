{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Routing economics trial record",
  "description": "One task, one arm, every attempt. Written append-only as JSONL; one record per line.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "arm",
    "task_id",
    "seed",
    "pair_key",
    "endpoint",
    "attempts",
    "recorded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "agent-routing-trial-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "arm": { "enum": ["all-large", "all-small", "routed", "inverted"] },
    "task_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "pair_key": {
      "type": "string",
      "description": "task_id|seed=N|env=NAME. Arms are comparable only over shared pair keys."
    },
    "endpoint": {
      "type": "string",
      "description": "Endpoint identity, including shared vs dedicated and, when dedicated, region and GPU type."
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/attempt" }
    }
  },
  "definitions": {
    "attempt": {
      "type": "object",
      "required": ["attempt_index", "succeeded", "wall_clock_ms", "calls"],
      "additionalProperties": false,
      "properties": {
        "attempt_index": { "type": "integer", "minimum": 1 },
        "succeeded": {
          "type": "boolean",
          "description": "Decided by the task verifier, not by the agent's own report."
        },
        "wall_clock_ms": { "type": "number", "minimum": 0 },
        "tool_ms": { "type": "number", "minimum": 0 },
        "failure_reason": { "type": ["string", "null"] },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/call" }
        }
      }
    },
    "call": {
      "type": "object",
      "required": [
        "step_kind",
        "tier",
        "model",
        "input_tokens",
        "output_tokens",
        "ttft_ms",
        "latency_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "step_kind": {
          "enum": ["classify", "plan", "hard_reasoning", "tool_format", "summarize", "verify"]
        },
        "tier": { "enum": ["small", "large"] },
        "model": {
          "type": "string",
          "description": "Recorded per call so a mid-run substitution is visible in raw evidence."
        },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Null means the endpoint did not report cache reuse. Null is unmeasured, not zero."
        },
        "ttft_ms": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
